<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WirelessBatterySetup</AssemblyName>
    <RootNamespace>WirelessBatterySetup</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <Product>Instalador — Monitor de Bateria Wireless &amp; Bluetooth</Product>
    <Company>Wireless Battery Monitor</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\KSnakeBatteryTray.exe.br" LogicalName="KSnakeBatteryTray.exe.br" />
  </ItemGroup>

</Project>
